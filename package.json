{
  "name": "family-recipes",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --env-file=.env --import tsx server/index.ts",
    "dev:web": "react-router dev",
    "build": "npm run build:web && npm run build:server",
    "build:web": "react-router build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --outfile=build/server/index.mjs --packages=external",
    "start": "node --env-file-if-exists=.env build/server/index.mjs",
    "typecheck": "tsc",
    "db:generate": "drizzle-kit generate",
    "seed": "node --env-file=.env --import tsx scripts/seed.ts",
    "create-user": "node --env-file=.env --import tsx scripts/create-user.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/drizzle-adapter": "^1.3.0",
    "@cline/llms": "^0.2.0",
    "@hono/node-server": "^1.14.0",
    "@hono/swagger-ui": "^0.5.0",
    "@hono/zod-openapi": "^1.0.0",
    "@react-router/node": "^7.18.5",
    "@tailwindcss/vite": "^4.3.3",
    "better-auth": "^1.3.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.9.0",
    "isbot": "^5",
    "lucide-react": "^1.66.0",
    "marked": "^18.1.2",
    "minisearch": "^7.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@react-router/dev": "^7.9.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "drizzle-kit": "^0.31.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
