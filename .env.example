# Port the API server listens on
PORT=3000

# Where the SQLite database (and later photos) live.
# In Docker this is overridden to /data (the mounted volume).
DATA_DIR=./data
# Optional: full explicit path (overrides DATA_DIR/recipes.db)
# DATABASE_PATH=./data/recipes.db

# better-auth — generate a real secret for anything beyond local dev:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# The origin the web app is served from (used for trusted origins / redirects)
BETTER_AUTH_URL=http://localhost:5173

# Photo import (AI extraction): greenPT as an OpenAI-compatible provider,
# called through the Cline SDK (@cline/llms). Leave empty to disable photo
# import — the route returns a friendly error until these are set.
GREENPT_API_KEY=
GREENPT_BASE_URL=
GREENPT_MODEL=

# Registration is invite-only: these emails may create accounts through the
# API while signed in. Other accounts are created via `npm run create-user`.
# Comma-separated.
ADMIN_EMAILS=seed@family.recipes
